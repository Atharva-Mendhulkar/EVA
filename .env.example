# NEXUS Environment Configuration
# WeMakeDevs × AWS First Commit, Ship It Track

# AWS Region (e.g. us-east-1)
AWS_REGION=us-east-1

# AWS Credentials for Live Amazon Bedrock Invocation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock Model Selection (Claude 3.5 Sonnet v2 / Amazon Nova Pro)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Deterministic Demo Mode (PRD Section 21)
# When set to true (or when AWS credentials are absent), NEXUS automatically
# falls back to verified deterministic fixtures ensuring a flawless 3-minute hackathon demo.
DEMO_MODE=true

# Port
PORT=3000
